# Copy to .env and fill in. NEVER commit .env
PORT=5000
CLIENT_URL=http://localhost:5173
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SECRET: backend only, never in the frontend
TZ_NAME=Asia/Kolkata
# Only used by `npm run seed` (min 8 characters). All demo accounts get this password.
SEED_PASSWORD=
