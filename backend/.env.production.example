# AttendHub Backend Production Environment Variables
# Configure these in your hosting dashboard (e.g. Render, Railway, Fly.io)

NODE_ENV=production
PORT=5000

# Allowed frontend origin(s) for CORS. Use comma-separated list or * to allow all
CLIENT_URL=https://your-frontend-domain.vercel.app

# Supabase Project URL & Service Role Secret Key (from Project Settings -> API)
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to the frontend!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Timezone (e.g. Asia/Kolkata, UTC)
TZ_NAME=Asia/Kolkata

# Set to true if deploying fullstack on a single service (Render/Railway/Docker)
SERVE_FRONTEND=true

# Demo accounts password for seed script (optional for production)
SEED_PASSWORD=your-secure-seed-password
